BRIDGE_CLIENT_SECRET=op://Dev-Shared/Bridge-IDX/client_secret
BRIDGE_DATASET_CODE=op://Dev-Shared/Bridge-IDX/dataset_code

# --- Brave Search (SHARED key — Dev-Shared) ---
BRAVE_API_KEY=op://Dev-Shared/Brave-Search/api_key

# --- Resend (PadMagnet's OWN key, distinct from the shared one) ---
RESEND_API_KEY=op://Dev-PadMagnet/Resend API Credentials/credential

# --- Vercel API token (SHARED — Dev-Shared) ---
VERCEL_TOKEN=op://Dev-Shared/Vercel API Credentials/credential

# --- Persistent test/marketing fixtures (DO NOT DELETE/rotate) ---
MAESTRO_OWNER_TEST_EMAIL=op://Dev-PadMagnet/PadMagnet-Test-Fixtures/maestro_owner_email
