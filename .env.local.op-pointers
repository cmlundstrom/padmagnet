# PadMagnet env — 1Password pointer file. Every secret is an op:// reference, NOT a
# secret value. Safe to keep on disk / sync. 1Password is the source of truth.
#
# Local dev / scripts resolve these at runtime via the headless fpm-sa service account:
#   op run --env-file=.env.local.op-pointers -- npm run dev
#   op run --env-file=.env.local.op-pointers -- node scripts/<whatever>.mjs
# (OP_SERVICE_ACCOUNT_TOKEN is read from C:\Users\chris\.op\fpm-sa.token in the shell env.)
#
# Regenerate/verify the equivalent plaintext anytime with: scripts/push_env_from_1pw.py

# --- Supabase (own project) ---
NEXT_PUBLIC_SUPABASE_URL=op://Dev-PadMagnet/Supabase-PadMagnet/project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=op://Dev-PadMagnet/Supabase-PadMagnet/anon_key
SUPABASE_SERVICE_ROLE_KEY=op://Dev-PadMagnet/Supabase-PadMagnet/service_role_key
SUPABASE_ACCESS_TOKEN=op://Dev-PadMagnet/Supabase-PadMagnet/access_token
DATABASE_URL=op://Dev-PadMagnet/Supabase-PadMagnet/database_url

# --- Stripe (LIVE) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=op://Dev-PadMagnet/Stripe-PadMagnet-LIVE/publishable_key
STRIPE_SECRET_KEY=op://Dev-PadMagnet/Stripe-PadMagnet-LIVE/secret_key
STRIPE_WEBHOOK_SECRET=op://Dev-PadMagnet/Stripe-PadMagnet-LIVE/webhook_secret

# --- Twilio (PadMagnet account) ---
TWILIO_ACCOUNT_SID=op://Dev-PadMagnet/Twilio-PadMagnet/account_sid
TWILIO_AUTH_TOKEN=op://Dev-PadMagnet/Twilio-PadMagnet/auth_token
TWILIO_PHONE_NUMBER=op://Dev-PadMagnet/Twilio-PadMagnet/phone_number

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=op://Dev-PadMagnet/Upstash-Redis-PadMagnet/rest_url
UPSTASH_REDIS_REST_TOKEN=op://Dev-PadMagnet/Upstash-Redis-PadMagnet/rest_token

# --- Google Geocoding (PadMagnet GCP key) ---
GOOGLE_GEOCODING_KEY=op://Dev-PadMagnet/Google-Geocoding-PadMagnet/geocoding_key
GOOGLE_SERVER_GEOCODING_KEY=op://Dev-PadMagnet/Google-Geocoding-PadMagnet/server_geocoding_key

# --- self-issued ---
CRON_SECRET=op://Dev-PadMagnet/PadMagnet-Platform-Secrets/cron_secret

# --- X.ai / Grok ---
XAI_API_KEY=op://Dev-PadMagnet/Xai API Credentials/credential

# --- Bridge / RESO MLS (SHARED account, miamire dataset — Dev-Shared, NO-TOUCH) ---
